---
// Shared mining dashboard for one language: stat row, by-show list,
// calendar heatmap with range picker. Used by /sla/ja/ and /sla/en/.
interface Props {
	stats: {
		total: number;
		learned: number;
		latestMinedAt: string | null;
		byShow: { show: string; count: number; learned: number; episodes: number[] }[];
		byDay: { date: string; count: number; shows: Record<string, number> }[];
	};
	generatedAt: string;
	studyHours?: string | null;
}

const { stats, generatedAt, studyHours = null } = Astro.props;

const counts = new Map(stats.byDay.map((d) => [d.date, d.count]));
const maxDay = Math.max(...stats.byDay.map((d) => d.count), 1);

// GitHub-style calendar heatmap: one column per week, rows are Sun..Sat,
// ending at the day the stats were generated.
const end = new Date(generatedAt);
end.setHours(0, 0, 0, 0);
// byDay dates are the author's local calendar days, while generatedAt is UTC:
// when mining happens after local midnight, generatedAt's UTC date can lag a
// day behind the latest byDay entry. Never end the window before the data.
if (stats.byDay.length) {
	const lastDay = new Date(`${stats.byDay[stats.byDay.length - 1].date}T00:00:00`);
	if (lastDay > end) end.setTime(lastDay.getTime());
}
const start = new Date(end);
start.setDate(start.getDate() - start.getDay() - 52 * 7);
// Never render before records begin: when the history is shorter than the
// 52-week window, start from the week containing the first recorded day.
if (stats.byDay.length) {
	const dataStart = new Date(`${stats.byDay[0].date}T00:00:00`);
	dataStart.setDate(dataStart.getDate() - dataStart.getDay());
	if (dataStart > start) start.setTime(dataStart.getTime());
}

const cells: { date: string; count: number }[] = [];
for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
	const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(
		d.getDate(),
	).padStart(2, '0')}`;
	cells.push({ date: iso, count: counts.get(iso) ?? 0 });
}

// Group into week columns; label a column when its month differs from the
// previous column's.
const weeks: (typeof cells)[] = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
const months: string[] = [];
let lastLabel = -3; // keep at least 2 empty columns between labels
weeks.forEach((week, i) => {
	const month = week[0].date.slice(5, 7);
	const changed = i === 0 || month !== weeks[i - 1][0].date.slice(5, 7);
	if (changed && i - lastLabel >= 3) {
		months.push(month);
		lastLabel = i;
	} else {
		months.push('');
	}
});
const rangeLabel = `${cells[0].date} → ${cells[cells.length - 1].date}`;

function level(count: number): number {
	if (count === 0) return 0;
	return Math.min(4, Math.ceil((count / maxDay) * 4));
}

const dataMin = stats.byDay.length ? stats.byDay[0].date : cells[0].date;
const dataMax = cells[cells.length - 1].date;

const learnedPct =
	stats.total > 0 ? Math.round((stats.learned / stats.total) * 100) : null;
---

<ul class="stat-row">
	{
		studyHours && (
			<li>
				<strong>{studyHours}</strong> hours reviewing
			</li>
		)
	}
	{
		stats.learned != null && (
			<li>
				<strong>{stats.learned}</strong> / {stats.total} learned
				{learnedPct != null && ` (${learnedPct}%)`}
			</li>
		)
	}
	<li>
		<strong>{stats.byDay.length}</strong> active days
	</li>
</ul>

<section>
	<h2>By show</h2>
	<ul class="show-list">
		{
			stats.byShow.map((s) => {
				const learned = s.learned ?? 0;
				const pct = s.count > 0 ? Math.round((learned / s.count) * 1000) / 10 : 0;
				return (
					<li
						class="show-progress"
						style={`background: linear-gradient(to right, color-mix(in srgb, var(--accent) 12%, transparent) ${pct}%, transparent ${pct}%)`}
					>
						<span class="show-name">{s.show}</span>
						<span class="show-meta">
							{learned}/{s.count} learned
							{s.episodes.length > 0 &&
								` · ${s.episodes.map((ep) => `EP${ep}`).join(', ')}`}
						</span>
					</li>
				);
			})
		}
	</ul>
</section>

<section id="mining-app" data-stats={JSON.stringify(stats.byDay)}>
	<h2>By day</h2>
	<div class="heatmap-wrap">
		<div class="heatmap-months" id="heatmap-months" aria-hidden="true">
			{months.map((m) => <span>{m}</span>)}
		</div>
		<div class="heatmap-body">
			<div class="heatmap-days" aria-hidden="true">
				<span />
				<span>Mon</span>
				<span />
				<span>Wed</span>
				<span />
				<span>Fri</span>
				<span />
			</div>
			<div class="heatmap" id="heatmap" role="img" aria-label={`Daily mining activity heatmap, ${rangeLabel}`}>
				{
					cells.map((c) => (
						<span
							class={`cell lv${level(c.count)}`}
							data-date={c.date}
							title={`${c.date} · ${c.count} cards`}
						/>
					))
				}
			</div>
		</div>
	</div>
	<div class="heatmap-legend">
		<span>Less</span>
		<span class="cell lv0" />
		<span class="cell lv1" />
		<span class="cell lv2" />
		<span class="cell lv3" />
		<span class="cell lv4" />
		<span>More</span>
	</div>

	<div class="range-picker">
		<label>
			From
			<input type="date" id="range-from" min={dataMin} max={dataMax} value={dataMin} />
		</label>
		<label>
			To
			<input type="date" id="range-to" min={dataMin} max={dataMax} value={dataMax} />
		</label>
		<button id="range-reset" type="button">Reset</button>
	</div>

	<details class="range-result">
		<summary>Range results</summary>
		<div aria-live="polite">
			<p class="range-total"><strong id="range-total" /></p>
			<ul class="show-list" id="range-shows" />
			<ul class="day-list" id="range-days" />
		</div>
	</details>
</section>

<script>
	const app = document.getElementById('mining-app');
	if (app) {
		const byDay = JSON.parse(app.dataset.stats ?? '[]');
		const counts = new Map(byDay.map((d) => [d.date, d.count]));
		const fromInput = document.getElementById('range-from');
		const toInput = document.getElementById('range-to');
		const resetButton = document.getElementById('range-reset');
		const totalEl = document.getElementById('range-total');
		const showsEl = document.getElementById('range-shows');
		const daysEl = document.getElementById('range-days');
		const monthsEl = document.getElementById('heatmap-months');
		const heatmapEl = document.getElementById('heatmap');
		const defaultFrom = fromInput.value;
		const defaultTo = toInput.value;

		const toDate = (iso) => new Date(`${iso}T00:00:00`);
		const toIso = (d) =>
			`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
		const levelOf = (count, max) =>
			count === 0 ? 0 : Math.min(4, Math.ceil((count / max) * 4));

		function renderHeatmap(from, to) {
			// One column per week, rows Sun..Sat, spanning [from, to].
			const start = toDate(from);
			start.setDate(start.getDate() - start.getDay());
			const end = toDate(to);

			const cells = [];
			for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
				const iso = toIso(d);
				cells.push({ date: iso, count: counts.get(iso) ?? 0 });
			}
			const max = Math.max(...cells.map((c) => c.count), 1);

			heatmapEl.replaceChildren(
				...cells.map((c) => {
					const cell = document.createElement('span');
					cell.className = `cell lv${levelOf(c.count, max)}`;
					cell.title = `${c.date} · ${c.count} cards`;
					return cell;
				}),
			);

			// Month labels: one per week column, only where the month changes,
			// with at least 2 empty columns between labels.
			const labels = [];
			let lastLabel = -3;
			let prevMonth = '';
			for (let i = 0; i < cells.length; i += 7) {
				const month = cells[i].date.slice(5, 7);
				if (month !== prevMonth && i / 7 - lastLabel >= 3) {
					labels.push(month);
					lastLabel = i / 7;
				} else {
					labels.push('');
				}
				prevMonth = month;
			}
			monthsEl.replaceChildren(
				...labels.map((m) => {
					const span = document.createElement('span');
					span.textContent = m;
					return span;
				}),
			);
		}

		function render() {
			let from = fromInput.value || defaultFrom;
			let to = toInput.value || defaultTo;
			if (from > to) [from, to] = [to, from];

			const days = byDay.filter((d) => d.date >= from && d.date <= to);
			const total = days.reduce((sum, d) => sum + d.count, 0);
			const shows = {};
			for (const d of days) {
				for (const [show, count] of Object.entries(d.shows ?? {})) {
					shows[show] = (shows[show] ?? 0) + count;
				}
			}
			const maxCount = Math.max(...days.map((d) => d.count), 1);

			totalEl.textContent = total > 0
				? `${total} cards between ${from} and ${to}`
				: `No cards between ${from} and ${to}`;

			showsEl.replaceChildren(
				...Object.entries(shows)
					.sort((a, b) => b[1] - a[1])
					.map(([show, count]) => {
						const li = document.createElement('li');
						const name = document.createElement('span');
						name.textContent = show;
						const meta = document.createElement('span');
						meta.className = 'show-meta';
						meta.textContent = `${count} cards`;
						li.append(name, meta);
						return li;
					}),
			);

			daysEl.replaceChildren(
				...days.map((d) => {
					const li = document.createElement('li');
					const date = document.createElement('span');
					date.className = 'day-date';
					date.textContent = d.date;
					const bar = document.createElement('span');
					bar.className = 'day-bar';
					bar.style.width = `${(d.count / maxCount) * 100}%`;
					const count = document.createElement('span');
					count.className = 'day-count';
					count.textContent = String(d.count);
					li.append(date, bar, count);
					return li;
				}),
			);

			renderHeatmap(from, to);
		}

		fromInput.addEventListener('change', render);
		toInput.addEventListener('change', render);
		resetButton.addEventListener('click', () => {
			fromInput.value = defaultFrom;
			toInput.value = defaultTo;
			render();
		});
		render();
	}
</script>

<style is:global>
	/* Shared stat styles (.show-list, .stat-row, .stat-note, .show-meta)
	   live in global.css; everything here is scoped under #mining-app to
	   avoid leaking generic class names. */
	#mining-app .day-list {
		list-style: none;
		padding: 0;
	}
	#mining-app .day-list li {
		display: grid;
		grid-template-columns: 7em 1fr 2em;
		align-items: center;
		gap: 0.8em;
		padding: 0.2em 0;
	}
	#mining-app .day-date {
		font-variant-numeric: tabular-nums;
	}
	#mining-app .day-bar {
		display: block;
		height: 0.7em;
		background: var(--accent);
		border-radius: 3px;
		min-width: 2px;
	}
	#mining-app .day-count {
		text-align: right;
	}
	#mining-app .heatmap-wrap {
		overflow-x: auto;
	}
	#mining-app .heatmap-months {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 11px;
		gap: 0;
		margin-left: 30px;
		margin-bottom: 4px;
		font-size: 11px;
		color: var(--text-secondary);
		font-variant-numeric: tabular-nums;
		width: max-content;
	}
	#mining-app .heatmap-months span {
		white-space: nowrap;
		overflow: visible;
	}
	#mining-app .heatmap-body {
		display: flex;
		gap: 4px;
		width: max-content;
	}
	#mining-app .heatmap-days {
		display: grid;
		grid-template-rows: repeat(7, 11px);
		font-size: 10px;
		line-height: 11px;
		color: var(--text-secondary);
		width: 26px;
	}
	#mining-app .heatmap {
		display: grid;
		grid-template-rows: repeat(7, 1fr);
		grid-auto-flow: column;
		gap: 2px;
		width: max-content;
	}
	#mining-app .cell {
		width: 9px;
		height: 9px;
		border-radius: 2px;
		background: var(--code-bg);
	}
	#mining-app .cell.lv1 {
		background: var(--accent);
		opacity: 0.3;
	}
	#mining-app .cell.lv2 {
		background: var(--accent);
		opacity: 0.55;
	}
	#mining-app .cell.lv3 {
		background: var(--accent);
		opacity: 0.8;
	}
	#mining-app .cell.lv4 {
		background: var(--accent);
	}
	#mining-app .heatmap-legend {
		display: flex;
		align-items: center;
		gap: 3px;
		margin-top: 0.6em;
		font-size: 12px;
		color: var(--text-secondary);
	}
	#mining-app .heatmap-legend span:first-child,
	#mining-app .heatmap-legend span:last-child {
		margin: 0 4px;
	}
	#mining-app .range-picker {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 1.5em;
		font-size: 14px;
		color: var(--text-secondary);
	}
	#mining-app .range-picker label {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	#mining-app .range-picker input[type='date'] {
		font: inherit;
		color: var(--text);
		background: var(--code-bg);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 4px 8px;
	}
	#mining-app .range-picker button {
		font: inherit;
		color: var(--text-secondary);
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 4px 12px;
		cursor: pointer;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}
	#mining-app .range-picker button:hover {
		color: var(--text);
		border-color: var(--text-secondary);
	}
	#mining-app .range-result {
		margin-top: 1em;
	}
	#mining-app .range-result summary {
		cursor: pointer;
		color: var(--text-secondary);
		font-size: 14px;
	}
	#mining-app .range-result summary:hover {
		color: var(--text);
	}
	#mining-app .range-total {
		margin-top: 0.6em;
	}
</style>
