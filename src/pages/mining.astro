---
import BaseLayout from '../layouts/BaseLayout.astro';
import MiningDashboard from '../components/MiningDashboard.astro';
import stats from '../data/mining-stats.json';

const studyHours =
	stats.studyMinutes != null ? (stats.studyMinutes / 60).toFixed(1) : null;
---

<BaseLayout title="Mining" description="Japanese immersion mining progress">
	<div class="container-narrow">
		<header class="page-header">
			<h1>Mining progress</h1>
			<p>
				{stats.total} cards mined while watching, last active {stats.latestMinedAt}.
				See also <a href="/mining/jlpt/">JLPT vocabulary coverage</a>.
			</p>
			<p class="stat-note">
				Review time only counts time-to-answer, so actual study time is
				higher. A card counts as learned once reviewed.
			</p>
		</header>

		<MiningDashboard
			stats={stats}
			generatedAt={stats.generatedAt}
			studyHours={studyHours}
		/>
	</div>
</BaseLayout>
