---
import BaseLayout from '../layouts/BaseLayout.astro';
import stats from '../data/mining-stats.json';

const counts = new Map(stats.byDay.map((d) => [d.date, d.count]));
const maxDay = Math.max(...stats.byDay.map((d) => d.count), 1);

// GitHub-style calendar heatmap: one column per week, rows are Sun..Sat,
// ending at the day the stats were generated.
const end = new Date(stats.generatedAt);
end.setHours(0, 0, 0, 0);
const start = new Date(end);
start.setDate(start.getDate() - start.getDay() - 52 * 7);

const cells: { date: string; count: number }[] = [];
for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
	const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(
		d.getDate(),
	).padStart(2, '0')}`;
	cells.push({ date: iso, count: counts.get(iso) ?? 0 });
}

// Group into week columns; label a column when its month differs from the
// previous column's.
const weeks: (typeof cells)[] = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
const months: string[] = [];
let lastLabel = -3; // keep at least 2 empty columns between labels
weeks.forEach((week, i) => {
	const month = week[0].date.slice(5, 7);
	const changed = i === 0 || month !== weeks[i - 1][0].date.slice(5, 7);
	if (changed && i - lastLabel >= 3) {
		months.push(month);
		lastLabel = i;
	} else {
		months.push('');
	}
});
const rangeLabel = `${cells[0].date} → ${cells[cells.length - 1].date}`;

function level(count: number): number {
	if (count === 0) return 0;
	return Math.min(4, Math.ceil((count / maxDay) * 4));
}
---

<BaseLayout title="Mining" description="Japanese immersion mining progress">
	<div class="container-narrow">
		<header class="page-header">
			<h1>Mining progress</h1>
			<p>
				{stats.total} cards mined while watching, last active {stats.latestMinedAt}.
			</p>
		</header>

		<section>
			<h2>By show</h2>
			<ul class="show-list">
				{
					stats.byShow.map((s) => (
						<li>
							<span class="show-name">{s.show}</span>
							<span class="show-meta">
								{s.count} cards · {s.episodes.map((ep) => `EP${ep}`).join(', ')}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section>
			<h2>By day</h2>
			<div class="heatmap-wrap">
				<div class="heatmap-months" aria-hidden="true">
					{months.map((m) => <span>{m}</span>)}
				</div>
				<div class="heatmap-body">
					<div class="heatmap-days" aria-hidden="true">
						<span />
						<span>Mon</span>
						<span />
						<span>Wed</span>
						<span />
						<span>Fri</span>
						<span />
					</div>
					<div class="heatmap" role="img" aria-label={`Daily mining activity heatmap, ${rangeLabel}`}>
						{
							cells.map((c) => (
								<span
									class={`cell lv${level(c.count)}`}
									title={`${c.date} · ${c.count} cards`}
								/>
							))
						}
					</div>
				</div>
			</div>
			<div class="heatmap-legend">
				<span>Less</span>
				<span class="cell lv0" />
				<span class="cell lv1" />
				<span class="cell lv2" />
				<span class="cell lv3" />
				<span class="cell lv4" />
				<span>More</span>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.show-list {
		list-style: none;
		padding: 0;
	}
	.show-list li {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.4em 0;
	}
	.show-meta {
		color: var(--text-secondary);
	}
	.heatmap-wrap {
		overflow-x: auto;
	}
	.heatmap-months {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 11px;
		gap: 0;
		margin-left: 30px;
		margin-bottom: 4px;
		font-size: 11px;
		color: var(--text-secondary);
		font-variant-numeric: tabular-nums;
		width: max-content;
	}
	.heatmap-months span {
		white-space: nowrap;
		overflow: visible;
	}
	.heatmap-body {
		display: flex;
		gap: 4px;
		width: max-content;
	}
	.heatmap-days {
		display: grid;
		grid-template-rows: repeat(7, 11px);
		font-size: 10px;
		line-height: 11px;
		color: var(--text-secondary);
		width: 26px;
	}
	.heatmap {
		display: grid;
		grid-template-rows: repeat(7, 1fr);
		grid-auto-flow: column;
		gap: 2px;
		width: max-content;
	}
	.cell {
		width: 9px;
		height: 9px;
		border-radius: 2px;
		background: var(--code-bg);
	}
	.cell.lv1 {
		background: var(--accent);
		opacity: 0.3;
	}
	.cell.lv2 {
		background: var(--accent);
		opacity: 0.55;
	}
	.cell.lv3 {
		background: var(--accent);
		opacity: 0.8;
	}
	.cell.lv4 {
		background: var(--accent);
	}
	.heatmap-legend {
		display: flex;
		align-items: center;
		gap: 3px;
		margin-top: 0.6em;
		font-size: 12px;
		color: var(--text-secondary);
	}
	.heatmap-legend span:first-child,
	.heatmap-legend span:last-child {
		margin: 0 4px;
	}
</style>
