---
import BaseLayout from '../layouts/BaseLayout.astro';
import stats from '../data/mining-stats.json';

const counts = new Map(stats.byDay.map((d) => [d.date, d.count]));
const maxDay = Math.max(...stats.byDay.map((d) => d.count), 1);

// GitHub-style calendar heatmap: one column per week, rows are Sun..Sat,
// ending at the day the stats were generated.
const end = new Date(stats.generatedAt);
end.setHours(0, 0, 0, 0);
const start = new Date(end);
start.setDate(start.getDate() - start.getDay() - 52 * 7 + 1);

const cells: { date: string; count: number }[] = [];
for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
	const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(
		d.getDate(),
	).padStart(2, '0')}`;
	cells.push({ date: iso, count: counts.get(iso) ?? 0 });
}

function level(count: number): number {
	if (count === 0) return 0;
	return Math.min(4, Math.ceil((count / maxDay) * 4));
}
---

<BaseLayout title="Mining" description="Japanese immersion mining progress">
	<div class="container-narrow">
		<header class="page-header">
			<h1>Mining progress</h1>
			<p>
				{stats.total} cards mined while watching, last active {stats.latestMinedAt}.
			</p>
		</header>

		<section>
			<h2>By show</h2>
			<ul class="show-list">
				{
					stats.byShow.map((s) => (
						<li>
							<span class="show-name">{s.show}</span>
							<span class="show-meta">
								{s.count} cards · {s.episodes.map((ep) => `EP${ep}`).join(', ')}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section>
			<h2>By day</h2>
			<div class="heatmap-wrap">
				<div class="heatmap" role="img" aria-label="Daily mining activity heatmap">
					{
						cells.map((c) => (
							<span
								class={`cell lv${level(c.count)}`}
								title={`${c.date} · ${c.count} cards`}
							/>
						))
					}
				</div>
			</div>
			<div class="heatmap-legend">
				<span>Less</span>
				<span class="cell lv0" />
				<span class="cell lv1" />
				<span class="cell lv2" />
				<span class="cell lv3" />
				<span class="cell lv4" />
				<span>More</span>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.show-list {
		list-style: none;
		padding: 0;
	}
	.show-list li {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.4em 0;
	}
	.show-meta {
		color: var(--text-secondary);
	}
	.heatmap-wrap {
		overflow-x: auto;
	}
	.heatmap {
		display: grid;
		grid-template-rows: repeat(7, 1fr);
		grid-auto-flow: column;
		gap: 2px;
		width: max-content;
	}
	.cell {
		width: 10px;
		height: 10px;
		border-radius: 2px;
		background: var(--code-bg);
	}
	.cell.lv1 {
		background: var(--accent);
		opacity: 0.3;
	}
	.cell.lv2 {
		background: var(--accent);
		opacity: 0.55;
	}
	.cell.lv3 {
		background: var(--accent);
		opacity: 0.8;
	}
	.cell.lv4 {
		background: var(--accent);
	}
	.heatmap-legend {
		display: flex;
		align-items: center;
		gap: 3px;
		margin-top: 0.6em;
		font-size: 12px;
		color: var(--text-secondary);
	}
	.heatmap-legend span:first-child,
	.heatmap-legend span:last-child {
		margin: 0 4px;
	}
</style>
